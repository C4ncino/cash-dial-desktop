---
import { Toast } from "webcoreui/astro";
---

<Toast id="income-created" theme="success">Ingreso creado!</Toast>
<Toast id="income-updated" theme="info">Ingreso actualizado!</Toast>
<Toast id="income-deleted" theme="alert">Ingreso eliminado!</Toast>

<Toast id="expense-created" theme="success">Gasto creado!</Toast>
<Toast id="expense-updated" theme="info">Gasto actualizado!</Toast>
<Toast id="expense-deleted" theme="alert">Gasto eliminado!</Toast>

<Toast id="transfer-created" theme="success">Transferencia creada!</Toast>
<Toast id="transfer-updated" theme="info">Transferencia actualizada!</Toast>
<Toast id="transfer-deleted" theme="alert">Transferencia eliminada!</Toast>
