---
import { Toast } from "webcoreui/astro";
---

<Toast id="income-created" className="app-toast" theme="success">Ingreso creado!</Toast>
<Toast id="income-updated" className="app-toast" theme="info">Ingreso actualizado!</Toast>
<Toast id="income-deleted" className="app-toast" theme="alert">Ingreso eliminado!</Toast>

<Toast id="expense-created" className="app-toast" theme="success">Gasto creado!</Toast>
<Toast id="expense-updated" className="app-toast" theme="info">Gasto actualizado!</Toast>
<Toast id="expense-deleted" className="app-toast" theme="alert">Gasto eliminado!</Toast>

<Toast id="transfer-created" className="app-toast" theme="success">Transferencia creada!</Toast>
<Toast id="transfer-updated" className="app-toast" theme="info">Transferencia actualizada!</Toast>
<Toast id="transfer-deleted" className="app-toast" theme="alert">Transferencia eliminada!</Toast>
