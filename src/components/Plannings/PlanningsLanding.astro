---
import { Icon } from "astro-icon/components";

import ActionButton from "@/components/General/ActionButton.astro";
import PlanningList from "@/components/Plannings/PlanningList";
import SectionHeader from "@/components/General/SectionHeader.astro";
---

<section class="space-y-4" aria-labelledby="all-plannings-title">
  <SectionHeader
    title="Planificaciones"
    description="Anticipa tus ingresos y gastos recurrentes."
    headingId="all-plannings-title"
  >
    <ActionButton
      slot="actions"
      id="create-planning-button"
      tone="primary"
    >
      <Icon name="iconoir:plus" class="size-5" aria-hidden="true" />
      Nueva planificación
    </ActionButton>
  </SectionHeader>

  <PlanningList showCreateButton={false} client:load />
</section>
