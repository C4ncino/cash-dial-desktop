---
import PlanningList from "@/components/Plannings/PlanningList";
---

<section class="space-y-4" aria-labelledby="all-plannings-title">
  <header class="flex items-center justify-between gap-4">
    <h2 id="all-plannings-title" class="text-2xl font-bold">
      Planificaciones
    </h2>
    <button
      id="create-planning-button"
      type="button"
      class="rounded-lg bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-500"
    >
      Nueva planificación
    </button>
  </header>

  <PlanningList showCreateButton={false} client:load />
</section>
