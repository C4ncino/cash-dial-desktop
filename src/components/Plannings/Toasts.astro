---
import { Toast } from "webcoreui/astro";
---

<Toast id="planning-created" className="app-toast" theme="success">Planificación creada!</Toast>
<Toast id="planning-updated" className="app-toast" theme="info">Planificación actualizada!</Toast>
<Toast id="planning-deleted" className="app-toast" theme="alert">Planificación eliminada!</Toast>
<Toast id="planning-activated" className="app-toast" theme="success">Planificación activada!</Toast>
<Toast id="planning-deactivated" className="app-toast" theme="info">Planificación desactivada!</Toast>
<Toast id="occurrence-canceled" className="app-toast" theme="alert">Ocurrencia cancelada!</Toast>
