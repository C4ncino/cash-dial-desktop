---
import colors from "tailwindcss/colors";
import { Icon } from "astro-icon/components";

import BudgetModals from "./Modals.astro";
import BudgetsList from "./BudgetsList";
import BudgetsToasts from "./Toasts.astro";
---

<section class="flex flex-row flex-wrap justify-center gap-3">
    <BudgetsList client:load />

    <button
        class="glass-surface h-28 w-48 cursor-pointer rounded-md p-3 text-lg font-medium text-zinc-950 transition-colors hover:bg-zinc-200/60 dark:text-zinc-100 dark:hover:bg-zinc-800/60"
        id="create-budget-button"
    >
        <Icon
            name="iconoir:plus-circle-solid"
            width={40}
            height={40}
            class="mx-auto"
            color={colors.green[500]}
        />
        Añadir presupuesto
    </button>
</section>

<BudgetModals />
<BudgetsToasts />
