---
import { Icon } from "astro-icon/components";
import SectionHeader from "@/components/General/SectionHeader.astro";

import BudgetModals from "./Modals.astro";
import BudgetsList from "./BudgetsList";

interface Props {
  title?: string;
  description?: string;
  headingLevel?: "h1" | "h2";
}

const {
  title = "Presupuestos",
  description = "Compara tus gastos actuales con los límites que definiste.",
  headingLevel = "h2",
} = Astro.props;
---

<section class="space-y-4 my-12" aria-labelledby="budgets-title">
  <SectionHeader
    title={title}
    description={description}
    headingId="budgets-title"
    level={headingLevel}
  >
    <button
      slot="actions"
      type="button"
      class="focus-ring inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-green-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-green-500 dark:bg-green-400 dark:text-zinc-950 dark:hover:bg-green-500"
      id="create-budget-button"
    >
      <Icon name="iconoir:plus" class="size-5 text-white dark:text-zinc-950" />
      Añadir presupuesto
    </button>
  </SectionHeader>

  <BudgetsList client:load />
</section>

<BudgetModals />
