---
import { Toast } from "webcoreui/astro";
---

<Toast id="budget-created" className="app-toast" theme="success">Presupuesto creado!</Toast>
<Toast id="budget-name-updated" className="app-toast" theme="info"
    >Nombre de presupuesto actualizado!</Toast
>
<Toast id="budget-amount-updated" className="app-toast" theme="info"
    >Límite de presupuesto actualizado!</Toast
>
<Toast id="budget-deleted" className="app-toast" theme="alert">Presupuesto eliminado!</Toast>
