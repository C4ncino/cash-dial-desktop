---
import { Modal } from "webcoreui/astro";

interface Props {
  id: string;
  title: string;
  className?: string;
}

const { id, title, className = "" } = Astro.props;
---

<Modal
  id={id}
  title={title}
  className={`glass-elevated w-[calc(100vw-2rem)]! max-w-lg! max-h-[calc(100dvh-2rem)] overflow-y-auto overscroll-contain backdrop-blur-md ${className}`}
>
  <slot />
</Modal>
