---
import colors from "tailwindcss/colors";
import { Icon } from "astro-icon/components";

import AccountModals from "./Modals.astro";
import AccountsList from "./AccountsList";
import AccountsToasts from "./Toasts.astro";
---

<section class="flex flex-row flex-wrap justify-center gap-3">
    <AccountsList client:load />

    <button
        class="h-28 w-48 bg-zinc-100 dark:bg-zinc-950 rounded-md p-3 font-medium text-lg dark:text-white cursor-pointer"
        id="create-account-button"
    >
        <Icon
            name="iconoir:plus-circle-solid"
            width={40}
            height={40}
            class="mx-auto"
            color={colors.green[500]}
        />
        Añadir cuenta
    </button>
</section>

<AccountModals />
<AccountsToasts />
