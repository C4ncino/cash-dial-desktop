---
export interface Props {
  href: string;
  isSelected?: boolean;
}

const { href, isSelected } = Astro.props;

const selected = isSelected ? "text-blue-600 border-blue-600 dark:text-blue-400 dark:border-blue-400" : "";
---

<li>
  <a
    tabindex="1"
    class={`font-semibold flex items-center gap-1 w-40
    text-zinc-700 dark:text-zinc-300 hover:text-red-600 focus:text-red-600 dark:hover:text-red-400 dark:focus:text-red-400 ${selected}`}
    href={href}
  >
    <slot />
  </a>
</li>
