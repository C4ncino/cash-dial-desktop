---
import { Icon } from "astro-icon/components";
import NavbarLink from "./NavbarLink.astro";

const links: Link[] = [
  {
    name: "Inicio",
    url: "/",
    icon: "iconoir:home-simple-door",
  },
  {
    name: "Movimientos",
    url: "/movements",
    icon: "iconoir:journal",
  },
  {
    name: "Planificación",
    url: "/planning",
    icon: "iconoir:clock",
  },
  {
    name: "Estadísticas",
    url: "/stats",
    icon: "iconoir:stats-up-square",
  },
  {
    name: "Más opciones",
    url: "/more",
    icon: "iconoir:more-horiz-circle",
  },
];
---

<nav>
  <ul id="links" class="space-y-4">
    {
      links.map((link) => (
        <NavbarLink
          href={link.url}
          isSelected={Astro.url.pathname === link.url}
        >
          <Icon name={link.icon || "iconoir:question-mark"} class="text-xl" />
          {link.name}
        </NavbarLink>
      ))
    }
  </ul>
</nav>
