---
import { Icon } from "astro-icon/components";
import NavbarLink from "./NavbarLink.astro";

interface Props {
  variant?: "desktop" | "mobile";
}

const { variant = "desktop" } = Astro.props;

const links: Link[] = [
  {
    name: "Inicio",
    url: "/",
    icon: "iconoir:home-simple-door",
  },
  {
    name: "Movimientos",
    url: "/movements",
    icon: "iconoir:journal",
  },
  {
    name: "Planificación",
    url: "/planning",
    icon: "iconoir:clock",
  },
  {
    name: "Estadísticas",
    url: "/stats",
    icon: "iconoir:stats-up-square",
  },
];
---

<nav aria-label={variant === "mobile" ? "Navegación móvil" : "Navegación principal"}>
  <ul class:list={[variant === "mobile" ? "grid gap-1" : "space-y-2"]}>
    {
      links.map((link) => (
        <NavbarLink
          href={link.url}
          isSelected={Astro.url.pathname === link.url}
          variant={variant}
        >
          <Icon name={link.icon || "iconoir:question-mark"} class="text-xl" />
          {link.name}
        </NavbarLink>
      ))
    }
  </ul>
</nav>
