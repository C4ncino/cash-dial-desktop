---
import { Icon } from "astro-icon/components";

interface Props {
  id?: string;
}

const { id = "back-link" } = Astro.props;
---

<a
    href="javascript:history.back()"
    id={id}
    class="focus-ring inline-flex min-h-10 items-center gap-2 rounded-lg px-2 text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-200"
>
    <Icon name="iconoir:arrow-left" size="1.25rem" />
    Regresar
</a>
