---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GlobalMovements from "@/components/Movements/GlobalMovements";
import MovementModals from "@/components/Movements/Modals.astro";
import MovementToasts from "@/components/Movements/Toasts.astro";
---

<BaseLayout title="Movimientos" description="Historial de todos los movimientos de cuentas">
  <div class="max-w-2xl mx-auto">
    <h1 class="mb-6 text-3xl font-bold text-zinc-950 dark:text-zinc-100">Movimientos</h1>
    <GlobalMovements client:load />
  </div>

  <MovementModals />
  <MovementToasts />
</BaseLayout>
