---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CreateSpeedDial from "@/components/Movements/CreateSpeedDial.astro";
import CreateMovementMenu from "@/components/Movements/CreateMovementMenu";
import GlobalMovements from "@/components/Movements/GlobalMovements";
import MovementModals from "@/components/Movements/Modals.astro";
---

<BaseLayout
  title="Movimientos"
  description="Historial de todos los movimientos de cuentas"
>
  <div class="mx-auto max-w-3xl">
    <header class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <h1 class="text-3xl font-bold text-zinc-950 dark:text-zinc-100">Movimientos</h1>
      <CreateMovementMenu client:load />
    </header>
    <GlobalMovements client:load />
  </div>

  <CreateSpeedDial />

  <MovementModals />
</BaseLayout>
