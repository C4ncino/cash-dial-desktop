---
import Accounts from "@/components/Accounts/Accounts.astro";
import CreateSpeedDial from "@/components/Movements/CreateSpeedDial.astro";
import MovementModals from "@/components/Movements/Modals.astro";
import MovementsLanding from "@/components/Movements/MovementsLanding";
import UrgentOccurrences from "@/components/Plannings/UrgentOccurrences";
import MovementToasts from "@/components/Movements/Toasts.astro";
import Budgets from "@/components/Budgets/Budgets.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { logger } from "@/lib/logger";

const TEST_MODE = process.env.VITE_TEST_MODE;

logger.debug(TEST_MODE);
---

<BaseLayout title="Home" description="">
  <div class="pb-24">
    <header>
      <h1 class="text-3xl font-bold">Resumen</h1>
      <p class="mt-1 text-zinc-700 dark:text-zinc-300">
        Una vista rápida de tus finanzas.
      </p>
    </header>
    <Accounts />
    <MovementsLanding client:load />
    <UrgentOccurrences limit={4} client:load />
    <Budgets />
  </div>

  <CreateSpeedDial />
  <MovementModals />
  <MovementToasts />
</BaseLayout>

<style></style>

{TEST_MODE && <script src="../lib/test.ts" />}
