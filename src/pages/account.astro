---
import AccountInfo from "@/components/Accounts/AccountInfo";
import AccountMovements from "@/components/Accounts/AccountMovements";
import ActionButtons from "@/components/Accounts/ActionButtons";
import DetailLayout from "@/layouts/DetailLayout.astro";
import AccountModals from "@/components/Accounts/Modals.astro";
import DetailShell from "@/components/General/DetailShell.astro";
---

<DetailLayout title="Detalles de Cuenta" description="">
  <DetailShell>
    <AccountInfo client:load />
    <AccountMovements client:load />
    <menu slot="actions" class="flex flex-wrap gap-2 sm:flex-col">
      <li>
        <button
          id="edit-account-button"
          type="button"
          class="focus-ring edit-button min-h-10 rounded-lg border border-zinc-400 text-sm font-medium dark:border-zinc-600 w-full h-full px-4 py-2 cursor-pointer"
          >Editar</button
        >
      </li>
      <ActionButtons client:load />
    </menu>
  </DetailShell>
</DetailLayout>

<AccountModals />

<script>
  import { EDIT_TYPES } from "@/types/enums";
  import { editStore } from "@/stores/editStore";

  document.addEventListener("astro:page-load", () => {
    const btn = document.getElementById("edit-account-button");

    if (!btn) return;

    btn.addEventListener("click", () => {
      const id = new URLSearchParams(window.location.search).get("id");

      if (!id) throw new Error("Account ID not found");

      editStore.getState().setId(Number(id), EDIT_TYPES.ACCOUNT);
    });
  });
</script>
