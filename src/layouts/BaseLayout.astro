---
import Footer from "@/components/Footer/Footer.astro";
import Header from "@/components/Header/Header.astro";
import Head from "@/components/SEO/Head.astro";
import "@/styles/global.css";
import "@/styles/webcore-setup.scss";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head {...props} />
  </head>
  <body>
    <div
      class="min-h-dvh flex flex-row bg-zinc-200 dark:bg-zinc-900 gradient-bg dark:text-white"
    >
      <aside class="flex flex-col justify-between p-4 max-h-dvh sticky top-0">
        <Header />
        <Footer />
      </aside>

      <main class="p-4 w-full">
        <slot />
      </main>
    </div>
  </body>
</html>

<script>
  import { initStores } from "@/lib/init";
  import { bodyFreeze } from "webcoreui";

  initStores();

  function handleClose(event: CustomEvent<{ id: string }>) {
    const id = event.detail.id;

    const modal = document.getElementById(id) as HTMLDialogElement;

    modal.dataset.show = "true";

    bodyFreeze(true);
  }

  window.addEventListener("modal:open", handleClose as EventListener);

  window.addEventListener("astro:before-swap", () => {
    window.removeEventListener("modal:open", handleClose as EventListener);
  });
</script>
