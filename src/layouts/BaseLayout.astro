---
import Footer from "@/components/Footer/Footer.astro";
import Header from "@/components/Header/Header.astro";
import MobileHeader from "@/components/Header/MobileHeader.astro";
import Head from "@/components/SEO/Head.astro";
import "@/styles/global.css";
import "@/styles/webcore-setup.scss";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const props = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <Head {...props} />
  </head>
  <body>
    <div
      class="gradient-bg flex min-h-dvh flex-col bg-zinc-50 text-zinc-950 dark:bg-zinc-950 dark:text-zinc-100 md:flex-row"
    >
      <MobileHeader />
      <aside
        class="sticky top-0 hidden h-dvh w-56 shrink-0 flex-col justify-between overflow-y-auto p-4 md:flex"
      >
        <Header />
        <Footer />
      </aside>

      <main
        class="min-w-0 flex-1 mx-auto w-full max-w-5xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8"
      >
        <slot />
      </main>
    </div>
  </body>
</html>

<script>
  import { initStores } from "@/lib/init";
  import { bodyFreeze } from "webcoreui";

  initStores();

  function handleClose(event: CustomEvent<{ id: string }>) {
    const id = event.detail.id;

    const modal = document.getElementById(id) as HTMLDialogElement;

    modal.dataset.show = "true";

    bodyFreeze(true);
  }

  window.addEventListener("modal:open", handleClose as EventListener);

  window.addEventListener("astro:before-swap", () => {
    window.removeEventListener("modal:open", handleClose as EventListener);
  });
</script>
