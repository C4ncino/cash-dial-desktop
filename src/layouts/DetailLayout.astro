---
import Head from "@/components/SEO/Head.astro";
import GoBackLink from "@/components/Header/GoBackLink.astro";
import ThemeToggle from "@/components/Header/ThemeToggle.astro";
import AppToasts from "@/components/General/AppToasts.astro";
import "@/styles/global.css";
import "@/styles/webcore-setup.scss";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const props = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <Head {...props} />
  </head>
  <body>
    <div
      class="gradient-bg flex min-h-dvh flex-col bg-zinc-50 text-zinc-950 dark:bg-zinc-950 dark:text-zinc-100 md:flex-row"
    >
      <header
        class="glass-elevated sticky top-0 z-40 flex items-center justify-between border-x-0 border-t-0 px-4 py-3 md:hidden"
      >
        <GoBackLink id="mobile-back-link" />
        <ThemeToggle />
      </header>
      <aside
        class="sticky top-0 hidden h-dvh w-56 shrink-0 flex-col p-4 md:flex"
      >
        <div class="flex flex-col gap-4">
          <GoBackLink />
          <ThemeToggle />
        </div>
      </aside>

      <main
        class="min-w-0 flex-1 mx-auto w-full max-w-3xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8"
      >
        <slot />
      </main>
      <AppToasts />
    </div>
  </body>
</html>

<script>
  import { initStores } from "@/lib/init";
  import { editStore } from "@/stores/editStore";
  import { bodyFreeze } from "webcoreui";

  initStores();

  function handleClose(event: CustomEvent<{ id: string }>) {
    const id = event.detail.id;

    const modal = document.getElementById(id) as HTMLDialogElement;

    modal.dataset.show = "true";

    bodyFreeze(true);
  }

  window.addEventListener("modal:open", handleClose as EventListener);

  window.addEventListener("astro:before-swap", () => {
    window.removeEventListener("modal:open", handleClose as EventListener);
    editStore.getState().clear();
  });
</script>
